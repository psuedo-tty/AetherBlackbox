<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<AssemblyName>AetherBlackbox</AssemblyName>
		<RootNamespace>AetherBlackbox</RootNamespace>
		<InternalName>AetherBlackbox</InternalName>
		<AssemblyVersion>7.55.0.0</AssemblyVersion>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<LangVersion>latest</LangVersion>
		<Description>Visual replay of positions before death. DeathRecap+AetherDraw</Description>
		<PackageProjectUrl>https://github.com/rail2025/AetherBlackbox/</PackageProjectUrl>
		<Authors>rail</Authors>
		<Version>7.55.0.0</Version>
		<NoWarn>CA1416</NoWarn>
		<AcceptsFeedback>false</AcceptsFeedback>
		<PathMap>$(MSBuildProjectDirectory)=AetherBlackbox</PathMap>
	</PropertyGroup>
	<ItemGroup>
	  <EmbeddedResource Include="PluginImages\**\*" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Remove="Windows\PropertiesWindowgodfile.cs" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="Core\Mechanics\Presets\M10s.json" />
	  <EmbeddedResource Include="Core\Mechanics\Presets\M11s.json" />
	  <EmbeddedResource Include="Core\Mechanics\Presets\M12sP1.json" />
	  <EmbeddedResource Include="Core\Mechanics\Presets\M12sP2.json" />
	  <EmbeddedResource Include="Core\Mechanics\Presets\UMAD.json" />
	</ItemGroup>

		
	<ItemGroup>
	 
	  <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
	  <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
	  <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
	  <PackageReference Include="SixLabors.ImageSharp.Web" Version="3.2.0" />
	  <PackageReference Include="SkiaSharp" Version="3.119.1" />
	  <PackageReference Include="Svg.Skia" Version="3.2.1" />
	</ItemGroup>

		
</Project>